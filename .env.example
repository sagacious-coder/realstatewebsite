# ==========================================
# Wild Hills Real Estate - Environment Configuration
# ==========================================

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site privacy & indexing control (true during staging/development, false for production launch)
SITE_PRIVATE=true

# Supabase Public & Client Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Server-Only Service Role Key (NEVER expose to client code)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend API for lead and inquiry alert notifications
RESEND_API_KEY=re_your_api_key
LEADS_EMAIL_TO=leads@wildhills.com

# Cloudflare Turnstile Spam Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Daily Exchange Rate Provider (e.g., openexchangerates, exchangerate-api, or frankfurter)
EXCHANGE_RATE_PROVIDER=frankfurter
EXCHANGE_RATE_API_KEY=optional_provider_api_key
