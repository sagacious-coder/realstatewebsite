{
  "name": "@wild-hills/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed client with mock and live adapters for Wild Hills API",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --outDir dist",
    "lint": "node -e \"console.log('api-client lint pass')\"",
    "typecheck": "tsc --noEmit",
    "test": "tsc --outDir dist && node --test test/**/*.test.mjs"
  },
  "dependencies": {
    "@wild-hills/contracts": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@wild-hills/config": "workspace:*",
    "typescript": "^5.7.0"
  }
}
