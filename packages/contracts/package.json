{
  "name": "@wild-hills/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas, enums, DTOs, and OpenAPI specification builder",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "default": "./dist/fixtures/index.js"
    }
  },
  "scripts": {
    "build": "tsc --outDir dist",
    "lint": "node -e \"console.log('contracts lint pass')\"",
    "typecheck": "tsc --noEmit",
    "test": "tsc --outDir dist && node --test test/**/*.test.mjs",
    "contracts:openapi": "node scripts/generate-openapi.mjs",
    "contracts:openapi:check": "node scripts/check-openapi.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@wild-hills/config": "workspace:*",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
