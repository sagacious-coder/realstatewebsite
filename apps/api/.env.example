# ==========================================
# Wild Hills API - Environment Configuration (Section 3.3)
# ==========================================

# PostgreSQL connection string
DATABASE_URL=postgres://wh_owner:change-me-password@localhost:5432/wild_hills

# HMAC key for on-demand ISR revalidation
REVALIDATE_SECRET=change-me-revalidate-secret

# Public CDN image host
IMAGE_CDN_HOST=https://cdn.wildhills.com

# S3-compatible storage configuration (Cloudflare R2 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_PUBLIC=wild-hills-public
S3_BUCKET_PRIVATE=wild-hills-private

# Resend API for worker email sending
RESEND_API_KEY=re_change_me
