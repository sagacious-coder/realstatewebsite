{
  "name": "@wild-hills/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wild Hills Fastify backend API and pg-boss background worker",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node --watch dist/server.js",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "node -e \"console.log('API lint pass')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@wild-hills/config": "workspace:*",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@wild-hills/contracts": "workspace:*",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
