# ==========================================
# Wild Hills Web (Public Site) - Environment Configuration (Section 3.3)
# ==========================================

# Canonical site URL
SITE_URL=http://localhost:3000

# Site privacy & indexing control (true during staging/development, false for production launch)
SITE_PRIVATE=true

# API endpoint
API_BASE_URL=http://localhost:4000

# Service credential for public API surface
API_TOKEN_WEB=change-me-web-service-token

# HMAC key for on-demand ISR revalidation
REVALIDATE_SECRET=change-me-revalidate-secret

# Public CDN image host
IMAGE_CDN_HOST=https://cdn.wildhills.com

# Cloudflare Turnstile public key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
